{
	"compilerOptions": {
		"target": "es2020",
		"module": "es2020",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"lib": [
			"es2020",
			"dom"
		],
		"strict": true,
		"outDir": "./dist/",
		"sourceMap": true,
		"declaration": false,
		"declarationMap": false,
		"jsx": "react-jsx",
		"jsxImportSource": "@emotion/react",
	},
	"exclude": [
		"**/node_modules/*",
		"**/dist/**",
	],
	"include": [
		"src",
		"types.ts"	
	],
}