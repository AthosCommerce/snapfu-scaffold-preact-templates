{
	"compilerOptions": {
		"target": "es2020",
		"module": "es2020",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"lib": ["es2020", "dom"],
		"strict": false,
		"rootDir": "./src",
		"outDir": "./dist/",
		"sourceMap": true,
		"declaration": false,
		"declarationMap": false,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
	},
	"exclude": ["**/node_modules/*", "**/dist/**"],
	"include": ["src"]
}
