{
	"compilerOptions": {
		"target": "es2020",
		"module": "es2020",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"lib": ["es2020", "dom"],
		"strict": false,
		"rootDir": "./src",
		"outDir": "./dist/",
		"sourceMap": true,
		"declaration": false,
		"declarationMap": false,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"skipLibCheck": true,
		"paths": {
			"react": ["./node_modules/preact/compat/"],
			"react-dom": ["./node_modules/preact/compat/"],
		},
	},
	"exclude": ["**/node_modules/*", "**/dist/**"],
	"include": ["src"]
}
