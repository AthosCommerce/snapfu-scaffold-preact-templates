{
	"name": "{{ snapfu.name }}",
	"author": "{{ snapfu.author }}",
	"version": "0.1.0",
	"license": "MIT",
	"main": "index.js",
	"private": true,
	"scripts": {
		"analyze": "webpack --config webpack.modern.js --analyze",
		"analyze:universal": "webpack --config webpack.universal.js --analyze",
		"build": "rm -rf ./dist && webpack --config webpack.modern.js && webpack --config webpack.universal.js",
		"test": "echo \"No tests for Snap template project\"",
		"clean": "rm -rf ./node_modules && rm -f ./package-lock.json",
		"dev": "kill $(lsof -ti:3333,8888); webpack serve --config webpack.dev.js",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
		"lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx}\"",
		"prepare": "husky install"
	},
	"searchspring": {
		"siteId": {
			"{{ snapfu.siteId }}": {
				"name": "{{ snapfu.name }}"
			}
		},
		"framework": "preact",
		"distribution": "templates",
		"updates": [
			"all"
		],
		"tags": ["templates", "{{ snapfu.variables.platform }}"],
		"version": "1.2.2",
		"scaffold": "snapfu-scaffold-preact-templates"
	},
	"prettier": "@searchspring/prettier",
	"dependencies": {
		"@searchspring/snap-preact": "1.2.2",
		"mobx": "6.9.0",
		"mobx-react": "7.6.0",
		"preact": "10.9.0"
	},
	"devDependencies": {
		"@babel/core": "^7.21.4",
		"@babel/eslint-parser": "^7.21.3",
		"@babel/plugin-transform-react-jsx": "^7.21.0",
		"@babel/plugin-transform-runtime": "^7.21.4",
		"@babel/preset-env": "^7.21.4",
		"@babel/preset-react": "^7.18.6",
		"@babel/runtime": "^7.21.0",
		"@emotion/react": "11.13.0",
		"@searchspring/browserslist-config-snap": "^1.0.6",
		"@searchspring/prettier": "^1.0.2",
		"babel-loader": "^9.1.2",
		"core-js": "^3.30.0",
		"css-loader": "^6.7.3",
		"eslint": "^8.37.0",
		"eslint-plugin-react": "^7.32.2",
		"husky": "^8.0.3",
		"lint-staged": "^13.2.0",
		"prettier": "^2.8.7",
		"webpack": "^5.77.0",
		"webpack-bundle-analyzer": "^4.8.0",
		"webpack-cli": "^5.0.1",
		"webpack-dev-server": "^4.13.2",
		"webpack-merge": "^5.8.0",
		"whatwg-fetch": "3.6.2",
		"ts-loader": "9.5.1"
	},
	"lint-staged": {
		"./package.json": [
			"prettier --write"
		],
		"./src/**/*.{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"browserslist": {
		"modern": "extends @searchspring/browserslist-config-snap/modern",
		"universal": "extends @searchspring/browserslist-config-snap/universal"
	}
}
