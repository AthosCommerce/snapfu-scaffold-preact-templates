{
	"name": "{{ snapfu.name }}",
	"author": "{{ snapfu.author }}",
	"version": "0.1.0",
	"license": "MIT",
	"main": "index.js",
	"private": true,
	"scripts": {
		"analyze": "webpack --config webpack.modern.js --analyze",
		"analyze:universal": "webpack --config webpack.universal.js --analyze",
		"build": "rm -rf ./dist && webpack --config webpack.modern.js && webpack --config webpack.universal.js",
		"test": "echo \"No tests for Snap template project\"",
		"lighthouse": "lhci --config ./tests/lighthouse/lighthouserc.js autorun",
		"clean": "rm -rf ./node_modules && rm -f ./package-lock.json",
		"dev": "webpack serve --config webpack.dev.js",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
		"lint": "eslint --fix \"./src/**/*.{js,jsx,ts,tsx}\"",
		"typecheck": "tsc --noEmit"
	},
	"athos": {
		"version": "1.17.0",
		"siteId": {
			"{{ snapfu.siteId }}": {
				"name": "{{ snapfu.name }}"
			}
		},
		"framework": "preact",
		"distribution": "templates",
		"updates": [
			"all"
		],
		"tags": [
			"templates",
			"{{ snapfu.variables.platform }}"
		],
		"scaffold": "snapfu-scaffold-preact-templates"
	},
	"prettier": "@searchspring/prettier",
	"dependencies": {
		"@athoscommerce/snap-preact": "1.17.0",
		"mobx": "6.15.1",
		"mobx-react-lite": "4.1.1",
		"preact": "10.28.4"
	},
	"devDependencies": {
		"@babel/core": "7.29.13",
		"@babel/plugin-transform-react-jsx": "7.29.7",
		"@babel/plugin-transform-runtime": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@babel/preset-react": "7.29.7",
		"@babel/runtime": "7.29.13",
		"@lhci/cli": "0.15.1",
		"@searchspring/browserslist-config-snap": "1.0.7",
		"@searchspring/prettier": "1.0.2",
		"@typescript-eslint/parser": "8.72.1",
		"babel-loader": "10.1.1",
		"core-js": "3.51.0",
		"css-loader": "7.1.5",
		"eslint": "9.39.5",
		"eslint-plugin-react": "7.37.5",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"prettier": "3.9.10",
		"ts-loader": "9.5.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"webpack": "5.112.2",
		"webpack-bundle-analyzer": "5.4.1",
		"webpack-cli": "6.0.1",
		"webpack-dev-server": "5.2.7",
		"webpack-merge": "6.0.1",
		"whatwg-fetch": "3.6.20"
	},
	"lint-staged": {
		"./package.json": [
			"prettier --write"
		],
		"./src/**/*.{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"browserslist": {
		"modern": "extends @searchspring/browserslist-config-snap/modern",
		"universal": "extends @searchspring/browserslist-config-snap/universal"
	}
}